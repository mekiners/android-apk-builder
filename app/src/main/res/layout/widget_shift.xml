<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/s_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="13dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/s_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/jersey15_regular"
            android:maxLines="1"
            android:text="Next shift"
            android:textColor="#2C1E11"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/s_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jersey15_regular"
            android:maxLines="2"
            android:textColor="#2C1E11"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:background="#B8946A" />

        <TextView
            android:id="@+id/s_up1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/jersey15_regular"
            android:maxLines="1"
            android:textColor="#6B4423"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/s_up2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/jersey15_regular"
            android:maxLines="1"
            android:textColor="#6B4423"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/s_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jersey15_regular"
            android:text="Off the clock"
            android:textColor="#2C1E11"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/s_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/btn_in"
            android:fontFamily="@font/jersey15_regular"
            android:gravity="center"
            android:minWidth="84dp"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="9dp"
            android:text="TIME IN"
            android:textColor="#FFF8E7"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
