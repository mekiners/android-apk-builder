<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel"
    android:orientation="vertical"
    android:padding="13dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/jersey15_regular"
            android:maxLines="1"
            android:text="Daily Quests"
            android:textColor="#2C1E11"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jersey15_regular"
            android:text="0/0"
            android:textColor="#6B4423"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="3dp"
        android:background="#B8946A" />

    <TextView
        android:id="@+id/w_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/jersey15_regular"
        android:maxLines="1"
        android:textColor="#2C1E11"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/w_line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/jersey15_regular"
        android:maxLines="1"
        android:textColor="#2C1E11"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/w_line3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/jersey15_regular"
        android:maxLines="1"
        android:textColor="#2C1E11"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/w_line4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/jersey15_regular"
        android:maxLines="1"
        android:textColor="#2C1E11"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/w_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jersey15_regular"
        android:textColor="#6B4423"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jersey15_regular"
        android:paddingTop="6dp"
        android:textColor="#2C1E11"
        android:textSize="16sp" />
</LinearLayout>
